digraph G {
  rankdir=TB;
  graph [fontname="Arial", bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.55"];
  node [shape=box, style="rounded", fontname="Arial", fontsize=11, margin="0.16,0.10"];
  edge [fontname="Arial", fontsize=9];

  GH [label="GitHub"];
  CF [label="Confluence"];
  PDF [label="PDF"];
  DL [label="Document Loaders"];
  CD [label="Cleaning + Deduplication"];
  CH [label="Chunking"];
  ST [label="Sentence-Transformers"];
  F [label="FAISS"];
  AUTH [label="Authentication / Roles"];
  ACL [label="ACL / Metadata Filtering"];
  SS [label="Similarity Search"];
  RC [label="Relevance Check"];
  IDK [label="Я не знаю"];
  TK [label="Top-K Context"];
  SPR [label="Security Policy Router"];
  LL [label="Local LLM"];
  CL [label="Cloud LLM"];
  A [label="Answer"];

  {rank=same; GH; CF; PDF}
  GH -> DL;
  CF -> DL;
  PDF -> DL;
  DL -> CD -> CH -> ST -> F;
  AUTH -> ACL;
  F -> ACL;
  ACL -> SS -> RC;
  RC -> IDK [label="low relevance"];
  RC -> TK [label="relevant"];
  TK -> SPR;
  SPR -> LL [label="sensitive"];
  SPR -> CL [label="allowed"];
  LL -> A;
  CL -> A;
}
