@startuml
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}

rectangle "GitHub" as GH
rectangle "Confluence" as CF
rectangle "PDF" as PDF
rectangle "Document Loaders" as DL
rectangle "Cleaning + Deduplication" as CD
rectangle "Chunking" as CH
rectangle "Sentence-Transformers" as ST
rectangle "FAISS" as F
rectangle "Authentication / Roles" as AUTH
rectangle "ACL / Metadata Filtering" as ACL
rectangle "Similarity Search" as SS
rectangle "Relevance Check" as RC
rectangle "Я не знаю" as IDK
rectangle "Top-K Context" as TK
rectangle "Security Policy Router" as SPR
rectangle "Local LLM" as LL
rectangle "Cloud LLM" as CL
rectangle "Answer" as A

GH --> DL
CF --> DL
PDF --> DL
DL --> CD
CD --> CH
CH --> ST
ST --> F
AUTH --> ACL
F --> ACL
ACL --> SS
SS --> RC
RC --> IDK : low relevance
RC --> TK : relevant
TK --> SPR
SPR --> LL : sensitive
SPR --> CL : allowed
LL --> A
CL --> A
@enduml
